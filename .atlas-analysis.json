  "keyFeatures": [
    "Multi-role authentication system (Admin, Teacher, Student)",
    "Project registration and lifecycle management",
    "Teacher evaluation system with scoring rubrics",
    "Student dashboard for tracking project feedback",
    "Admin panel for user and project management",
    "Public results gallery and historical rankings",
    "Row-level security with Supabase RLS policies",
    "Responsive design with light/dark theme support"
  ],
